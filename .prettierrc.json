{
  "printWidth": 120,
  "plugins": ["prettier-plugin-organize-imports", "prettier-plugin-solidity"],
  "overrides": [
    {
      "files": ["*.ts", ".js", ".cjs"],
      "options": {
        "singleQuote": true
      }
    },
    {
      "files": "*.sol",
      "options": {
        "singleQuote": false
      }
    }
  ]
}
